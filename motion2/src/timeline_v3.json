{
  "fps": 60,
  "total": 61.52,
  "segments": [
    {
      "id": "s01",
      "text": "Человек находит тебя в 2ГИС, видит карточку.",
      "start": 0.0,
      "dur": 2.96,
      "gap": 0.1,
      "mood": "neutral"
    },
    {
      "id": "s03",
      "text": "А дальше ему некуда идти.",
      "start": 3.06,
      "dur": 1.55,
      "gap": 0.1,
      "mood": "тяжело"
    },
    {
      "id": "s04",
      "text": "В карточке — адрес и телефон.",
      "start": 4.71,
      "dur": 1.82,
      "gap": 0.1,
      "mood": "буднично"
    },
    {
      "id": "s05",
      "text": "Но он не видит, какие услуги ты оказываешь, сколько они стоят и есть ли свободное окно.",
      "start": 6.63,
      "dur": 5.06,
      "gap": 0.1,
      "mood": "перечисление"
    },
    {
      "id": "s06",
      "text": "Звонить он не хочет.",
      "start": 11.79,
      "dur": 1.2,
      "gap": 0.1,
      "mood": "нетерпеливо"
    },
    {
      "id": "s07",
      "text": "Он хочет просто посмотреть.",
      "start": 13.09,
      "dur": 1.46,
      "gap": 0.1,
      "mood": "спокойно"
    },
    {
      "id": "s08",
      "text": "И в итоге уходит к конкуренту, у которого в карточке есть ссылка на сайт.",
      "start": 14.65,
      "dur": 3.91,
      "gap": 0.1,
      "mood": "neutral"
    },
    {
      "id": "s09",
      "text": "А теперь смотри, что меняется.",
      "start": 18.66,
      "dur": 2.0,
      "gap": 0.1,
      "mood": "смена"
    },
    {
      "id": "s10",
      "text": "Ты прикрепляешь к своей карточке в 2ГИС нормальный сайт.",
      "start": 20.76,
      "dur": 3.5,
      "gap": 0.1,
      "mood": "уверенно"
    },
    {
      "id": "s11",
      "text": "Человек заходит и сразу видит услуги, цены, фотографии работ.",
      "start": 24.36,
      "dur": 3.9,
      "gap": 0.1,
      "mood": "уверенно"
    },
    {
      "id": "s12",
      "text": "Понимает, что ты серьёзная компания, которой можно доверять.",
      "start": 28.36,
      "dur": 3.38,
      "gap": 0.1,
      "mood": "уверенно"
    },
    {
      "id": "s13",
      "text": "И звонит уже практически готовым клиентом.",
      "start": 31.84,
      "dur": 2.35,
      "gap": 0.1,
      "mood": "уверенно"
    },
    {
      "id": "s14",
      "text": "По данным самого 2ГИС, одна только ссылка на сайт в карточке повышает конверсию в звонок или запись почти на двадцать три процента.",
      "start": 34.29,
      "dur": 7.16,
      "gap": 0.1,
      "mood": "весомо"
    },
    {
      "id": "s15",
      "text": "Я делаю такие сайты.",
      "start": 41.55,
      "dur": 1.48,
      "gap": 0.1,
      "mood": "уверенно"
    },
    {
      "id": "s16",
      "text": "Стоимость — восемь тысяч рублей, половина оплачивается вперёд.",
      "start": 43.13,
      "dur": 3.75,
      "gap": 0.1,
      "mood": "уверенно"
    },
    {
      "id": "s17",
      "text": "Всё просто и красиво: услуги, цены, фотографии работ.",
      "start": 46.98,
      "dur": 3.64,
      "gap": 0.1,
      "mood": "спокойно"
    },
    {
      "id": "s18",
      "text": "Чтобы твоя карточка в 2ГИС наконец-то работала как надо.",
      "start": 50.72,
      "dur": 3.65,
      "gap": 0.1,
      "mood": "спокойно"
    },
    {
      "id": "s19",
      "text": "Хочешь посмотреть примеры?",
      "start": 54.47,
      "dur": 1.59,
      "gap": 0.1,
      "mood": "дружелюбно"
    },
    {
      "id": "s20",
      "text": "Напиши слово «сайт» — и я скину тебе портфолио.",
      "start": 56.16,
      "dur": 3.15,
      "gap": 0.1,
      "mood": "дружелюбно"
    },
    {
      "id": "s21",
      "text": "У меня уже много довольных клиентов!",
      "start": 59.41,
      "dur": 2.01,
      "gap": 0.1,
      "mood": "восторг"
    }
  ]
}