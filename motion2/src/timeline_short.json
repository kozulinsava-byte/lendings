      "dur": 3.77,
      "pause": 0.3,
      "mood": "уверенно, тепло",
      "rate": "+14%",
      "pitch": "+2Hz",
      "file": "C:\\Users\\user\\AppData\\Local\\Temp\\opencode\\motion2\\audio_short\\s08.mp3"
    },
    {
      "id": "s09",
      "text": "Ссылка на сайт поднимает конверсию в звонок почти на двадцать три процента.",
