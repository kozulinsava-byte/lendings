      "dur": 5.54,
      "pause": 0.35,
      "mood": "уверенно",
      "rate": "+12%",
      "pitch": "+5Hz",
      "file": "C:\\Users\\user\\AppData\\Local\\Temp\\opencode\\motion2\\audio_short\\s10.mp3"
    },
    {
