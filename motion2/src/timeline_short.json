      "dur": 3.41,
      "pause": 0.35,
      "mood": "уверенно",
      "rate": "+12%",
      "pitch": "+5Hz",
      "file": "C:\\Users\\user\\AppData\\Local\\Temp\\opencode\\motion2\\audio_short\\s07.mp3"
    },
    {
      "id": "s08",
      "text": "Сразу видно услуги, цены, фотографии работ.",
